---
// Root entry: always send visitors to the default locale (Hindi). Users can
// switch language from the navbar. A meta refresh + script keeps it working on
// static GitHub Pages hosting.
import { defaultLocale } from '../i18n/config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/${defaultLocale}`;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vishwa Sanatan Sansthanam</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p style="font-family: sans-serif; padding: 2rem; color: #333;">
      Redirecting… <a href={target}>Enter Vishwa Sanatan Sansthanam</a>
    </p>
  </body>
</html>
