---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/react/Hero.tsx';
import SanatanOrbit from '../../components/react/SanatanOrbit.tsx';
import TrustGallery from '../../components/react/TrustGallery.tsx';
import { locales, type Locale } from '../../i18n/config';
import { getDict } from '../../i18n/utils';
import { trustEvents } from '../../data/trustEvents';
import { services, servicesCta, sField } from '../../data/services';
import {
  objectivesHeading,
  allObjectivesLabel,
  introReadMore,
  introReadLess,
  heroObjectives,
  upcomingEventsHeading,
  upcomingEvents,
  hField,
} from '../../data/heroContent';
import Services from '../../components/react/Services.tsx';
import { aboutSections, aField } from '../../data/aboutUs';
import { members } from '../../data/members';
import Members from '../../components/react/Members.tsx';
import SacredSounds from '../../components/react/SacredSounds.tsx';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/${locale}`;

// Sanatan concepts for the orbiting slide (label only — no long descriptions).
const conceptOrbit = (Object.keys(t.concepts.items) as (keyof typeof t.concepts.items)[]).map(
  (key) => ({ key, label: t.concepts.items[key].title })
);

const todayIso = new Date().toISOString().slice(0, 10);

function formatFullDate(iso: string): string {
  try {
    return new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'short', day: 'numeric' }).format(
      new Date(iso + 'T00:00:00')
    );
  } catch {
    return iso;
  }
}

// Hero panel: auto-rotating trust events + upcoming festivals (year shown).
const trustSlides = trustEvents.slice(0, 6).map((e) => ({
  key: `trust-${e.src}`,
  image: e.src,
  dateLabel: formatFullDate(e.date),
  title: e.title,
}));

const trustGalleryItems = trustEvents.map((e) => ({ date: e.date, title: e.title, src: e.src }));

// Upcoming Sansthan events (today onward, soonest first).
function dayMonth(iso: string): { day: string; month: string } {
  const d = new Date(iso + 'T00:00:00');
  try {
    return {
      day: new Intl.DateTimeFormat(locale, { day: 'numeric' }).format(d),
      month: new Intl.DateTimeFormat(locale, { month: 'short' }).format(d),
    };
  } catch {
    return { day: iso.slice(8, 10), month: iso.slice(5, 7) };
  }
}

const upcomingRows = upcomingEvents
  .filter((e) => e.date >= todayIso)
  .sort((a, b) => (a.date < b.date ? -1 : 1))
  .slice(0, 4)
  .map((e) => ({
    key: e.id,
    ...dayMonth(e.date),
    title: hField(e.title, locale),
    place: hField(e.place, locale),
  }));

const heroObjectiveItems = heroObjectives.map((o) => ({ icon: o.icon, title: hField(o.title, locale) }));

const logoSrc = `${base}/static/vssn-logo.jpg`;

const serviceItems = services.map((s) => ({
  key: s.key,
  icon: s.icon,
  label: sField(s.label, locale),
  desc: sField(s.desc, locale),
}));

const aboutBlocks = aboutSections.map((s) => ({
  id: s.id,
  heading: aField(s.heading, locale),
  body: s.body ? aField(s.body, locale) : undefined,
  points: s.points ? aField(s.points, locale) : undefined,
}));
const introBlock = aboutBlocks.find((b) => b.body);
const objectivesBlock = aboutBlocks.find((b) => b.points);
---

<Layout locale={locale}>
  <Hero
    client:load
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    subtitle={t.hero.subtitle}
    lead={t.hero.lead}
    ctaExplore={t.hero.ctaExplore}
    ctaEvents={t.hero.ctaEvents}
    scroll={t.hero.scroll}
    exploreHref={`${home}#about`}
    eventsHref={`${home}#services`}
    trustName={t.trust.name}
    trustTagline={t.trust.tagline}
    eventsHeading={t.trust.eventsHeading}
    upcomingHeading={hField(upcomingEventsHeading, locale)}
    logoSrc={logoSrc}
    trustSlides={trustSlides}
    events={upcomingRows}
    objectivesHeading={hField(objectivesHeading, locale)}
    allObjectivesLabel={hField(allObjectivesLabel, locale)}
    objectives={heroObjectiveItems}
    introHeading={introBlock?.heading ?? ''}
    introBody={introBlock?.body ?? t.hero.lead}
    introReadMore={hField(introReadMore, locale)}
    introReadLess={hField(introReadLess, locale)}
    allObjectivesHeading={objectivesBlock?.heading ?? ''}
    allObjectives={objectivesBlock?.points ?? []}
    showLessLabel={t.about.showLess}
  />

  <section id="sanatan" class="scroll-mt-20 py-16 sm:py-24">
    <SanatanOrbit
      client:visible
      eyebrow={t.concepts.eyebrow}
      title={t.concepts.title}
      lead={t.concepts.lead}
      concepts={conceptOrbit}
      omLoopSrc={`${base}/static/om-chanting-1.mp3`}
    />
  </section>

  <section id="services" class="scroll-mt-20 py-16 sm:py-24">
    <Services
      client:visible
      eyebrow={t.services.eyebrow}
      title={t.services.title}
      lead={t.services.lead}
      items={serviceItems}
      cta={sField(servicesCta, locale)}
      phoneTel="+917388735905"
    />
  </section>

  <section id="members" class="scroll-mt-20 py-16 sm:py-24">
    <Members
      client:visible
      eyebrow={t.members.eyebrow}
      title={t.members.title}
      lead={t.members.lead}
      items={members}
    />
  </section>

  <section id="events" class="scroll-mt-20 py-16 sm:py-24">
    <TrustGallery
      client:visible
      eyebrow={t.trust.eyebrow}
      title={t.trust.eventsHeading}
      lead={t.trust.lead}
      noTrustEvents={t.events.noTrustEvents}
      locale={locale}
      items={trustGalleryItems}
    />
  </section>

  <section id="sounds" class="scroll-mt-20 py-16 sm:py-24">
    <SacredSounds
      client:visible
      eyebrow={t.sounds.eyebrow}
      title={t.sounds.title}
      lead={t.sounds.lead}
      download={t.sounds.download}
      omTitle={t.sounds.tracks.omChanting}
      shivaTitle={t.sounds.tracks.omNamahShivaya}
      omSrc={`${base}/static/om-chanting-1.mp3`}
      shivaSrc={`${base}/static/om-namah-shivaya-2.mp3`}
    />
  </section>
</Layout>
