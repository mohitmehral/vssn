---
// Vishwa Sanatan Sansthanam emblem — the official trust logo.
// Source of truth: public/static/vssn-logo.jpg (real emblem, square-cropped).
interface Props {
  class?: string;
  alt?: string;
}
const { class: className, alt = 'Vishwa Sanatan Sansthanam' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const LOGO_FILE = 'vssn-logo.jpg';
const src = `${base}/static/${LOGO_FILE}`;
---

<img src={src} alt={alt} class={className} loading="lazy" decoding="async" />
