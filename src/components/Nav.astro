---
import { getDict } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import LanguageSwitcher from './react/LanguageSwitcher.tsx';
import VssLogo from './VssLogo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Determine current path segment after locale for the language switcher.
const segments = Astro.url.pathname.replace(base, '').split('/').filter(Boolean);
// segments[0] is locale; the rest form the sub-path
const pathAfterLocale = segments.slice(1).join('/');

const home = `${base}/${locale}`;
const links = [
  { href: `${home}#sanatan`, label: t.nav.concepts },
  { href: `${home}#services`, label: t.services.title },
  { href: `${home}#members`, label: t.members.title },
  { href: `${home}#events`, label: t.nav.events },
  { href: `${home}#about`, label: t.nav.about },
];
---

<header
  id="site-nav"
  class="fixed top-0 z-40 w-full border-b border-transparent transition-all duration-300"
>
  <nav class="container-x flex items-center justify-between py-4">
    <a href={home} class="group flex items-center gap-3">
      <span class="grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-full bg-clay shadow-neu transition group-hover:-translate-y-0.5 group-hover:shadow-neu-hover">
        <VssLogo class="h-full w-full rounded-full object-cover" />
      </span>
      <span class="heading-serif hidden leading-tight sm:block">
        <span class="block text-base font-bold tracking-wide text-ink">{t.trust.name}</span>
        <span class="block text-[11px] font-medium tracking-wide text-saffron-deep">{t.trust.tagline}</span>
      </span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-full px-3 py-2 text-sm font-medium text-ink-soft transition hover:text-saffron-deep"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageSwitcher
        client:load
        current={locale}
        base={base}
        pathAfterLocale={pathAfterLocale}
        label={t.nav.language}
      />
      <button
        id="nav-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        class="grid h-11 w-11 place-items-center rounded-full bg-clay text-ink shadow-neu transition hover:shadow-neu-hover active:shadow-neu-inset md:hidden"
      >
        <svg id="nav-icon-open" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <svg id="nav-icon-close" class="hidden" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown menu -->
  <div id="nav-mobile" class="hidden bg-clay/95 backdrop-blur-lg md:hidden">
    <nav class="container-x flex flex-col gap-1 py-3">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="nav-mobile-link rounded-2xl px-4 py-3 text-sm font-medium text-ink-soft shadow-neu-inset-sm transition hover:text-saffron-deep"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // Add a solid backdrop to the nav once the user scrolls.
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 40) {
      nav.classList.add('bg-clay/90', 'backdrop-blur-lg', 'shadow-neu');
    } else {
      nav.classList.remove('bg-clay/90', 'backdrop-blur-lg', 'shadow-neu');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu toggle.
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');
  const setOpen = (open: boolean) => {
    if (!mobile || !toggle) return;
    mobile.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    // solid bg when menu open even at top of page
    nav?.classList.toggle('bg-clay/95', open);
    nav?.classList.toggle('backdrop-blur-lg', open);
  };
  toggle?.addEventListener('click', () => {
    const open = mobile?.classList.contains('hidden');
    setOpen(!!open);
  });
  // Close after tapping a link.
  document.querySelectorAll('.nav-mobile-link').forEach((a) =>
    a.addEventListener('click', () => setOpen(false))
  );
</script>
