---
import { getDict } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import VssLogo from './VssLogo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

// Official Vishwa Sanatan Sansthanam details (from the trust banner).
const trust = {
  regNo: 'IN-UP76422624409815Y',
  website: 'www.vssn.org.in',
  websiteUrl: 'https://www.vssn.org.in',
  email: 'vishwasanatansansthanam@gmail.com',
  phone: '+91 7388735905',
  phoneTel: '+917388735905',
  facebook: 'https://www.facebook.com/vishwasanatansansthanam',
  instagram: 'https://www.instagram.com/vishwasanatansansthanam',
  handle: '/vishwasanatansansthanam',
};
---

<footer class="relative mt-24 bg-clay">
  <div class="container-x py-14">
    <!-- Trust identity + contact, molded into one neu card -->
    <div class="grid gap-8 rounded-neu bg-clay p-8 shadow-neu md:grid-cols-[1.2fr_1fr] md:gap-10 md:p-10">
      <div>
        <div class="flex items-center gap-3">
          <span class="grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-full bg-clay shadow-neu-inset-deep">
            <VssLogo class="h-full w-full rounded-full object-cover" />
          </span>
          <div>
            <p class="heading-serif text-lg font-bold text-ink">{t.trust.name}</p>
            <p class="text-sm text-saffron-deep">{t.trust.tagline}</p>
          </div>
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-soft">{t.footer.tagline}</p>
        <div class="mt-5 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-2 rounded-full bg-clay px-4 py-2 text-xs font-medium text-ink shadow-neu-inset-sm">
            <span class="font-semibold text-saffron-deep">Reg. No.</span>
            <span class="tracking-wide">{trust.regNo}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-clay px-4 py-2 text-xs font-medium text-ink shadow-neu-inset-sm">
            <span aria-hidden="true">🇮🇳</span> Registered in India
          </span>
        </div>
      </div>

      <!-- Contact -->
      <div class="space-y-3 text-sm">
        <a
          href={trust.websiteUrl}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-3 text-ink-soft transition hover:text-saffron-deep"
        >
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-clay shadow-neu-inset-sm" aria-hidden="true">🌐</span>{trust.website}
        </a>
        <a
          href={`mailto:${trust.email}`}
          class="flex items-center gap-3 break-all text-ink-soft transition hover:text-saffron-deep"
        >
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-clay shadow-neu-inset-sm" aria-hidden="true">✉️</span>{trust.email}
        </a>
        <a
          href={`tel:${trust.phoneTel}`}
          class="flex items-center gap-3 text-ink-soft transition hover:text-saffron-deep"
        >
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-clay shadow-neu-inset-sm" aria-hidden="true">📞</span>{trust.phone}
        </a>
        <div class="flex flex-wrap gap-3 pt-1">
          <a href={trust.facebook} target="_blank" rel="noopener" class="neu-chip transition hover:text-saffron-deep" aria-label="Facebook">
            Facebook
          </a>
          <a href={trust.instagram} target="_blank" rel="noopener" class="neu-chip transition hover:text-saffron-deep" aria-label="Instagram">
            Instagram
          </a>
        </div>
      </div>
    </div>

    <div class="mt-8 text-center text-xs text-ink-faint">
      © {year} {t.trust.name}. {t.footer.rights}
    </div>
  </div>
</footer>
