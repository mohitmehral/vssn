---
import { getDict } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="relative mt-24 border-t border-ink/10 bg-paper-soft">
  <div class="container-x py-14">
    <div class="flex flex-col items-center gap-4 text-center">
      <span class="text-2xl text-accent-500" aria-hidden="true">ॐ</span>
      <p class="heading-serif max-w-xl text-lg text-ink">{t.footer.tagline}</p>
      <p class="text-sm text-ink-faint">{t.footer.rights}</p>
      <a
        href={`${base}/${locale}#sources`}
        class="text-sm text-accent-600 underline-offset-4 transition hover:underline"
        >{t.footer.sources}</a
      >
    </div>
    <div class="mt-10 border-t border-ink/10 pt-6 text-center text-xs text-ink-faint">
      © {year} Sanatan Dharma
    </div>
  </div>
</footer>
